{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jrautomotive-pages",
  "main": "./src/worker.js",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD772OaNDaSQ4dmS",
    "MESSAGE_FROM_EMAIL": "website@jrautomotive.nz",
    "MESSAGE_TO_EMAIL": "j.rfixyourcar@gmail.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "j.rfixyourcar@gmail.com"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
